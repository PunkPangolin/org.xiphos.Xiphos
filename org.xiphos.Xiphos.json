{
    "id": "org.xiphos.Xiphos",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "xiphos",
    "rename-desktop-file": "xiphos.desktop",
    "rename-icon": "xiphos",
    "rename-appdata-file": "xiphos.appdata.xml",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--share=network",
        "--persist=.sword",
        "--persist=.xiphos",
        "--talk-name=org.gnome.GConf",
        "--device=dri"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/doc",
        "/share/man",
        "*.a",
        "*.la"
    ],
    "modules": [
        {
            "name": "biblesync",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/karlkleinpaste/biblesync/releases/download/2.2.0/biblesync-2.2.0.tar.gz",
                    "sha256": "ea865789d1837a058fa84e24c31b0df85a3b78d54e07aea496b18bef31448a9e",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 15373,
                        "url-template": "https://github.com/karlkleinpaste/biblesync/releases/download/$version/biblesync-$version.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "sword",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "config-opts": [
                "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
                "-DSWORD_LINK_LIBRARIES=curl"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "http://crosswire.org/ftpmirror/pub/sword/source/v1.9/sword-1.9.0.tar.gz",
                    "sha256": "42409cf3de2faf1108523e2c5ac0745d21f9ed2a5c78ed878ee9dcc303426b8a",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 16287,
                        "url-template": "http://crosswire.org/ftpmirror/pub/sword/source/v${version0}.${version1}/sword-$version.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "minizip",
            "subdir": "contrib/minizip",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://zlib.net/zlib-1.3.2.tar.gz",
                    "sha256": "bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 5303,
                        "url-template": "https://zlib.net/zlib-$version.tar.gz"
                    }
                },
                {
                    "type": "patch",
                    "path": "patches/minizip-include-ints_h.patch"
                },
                {
                    "type": "script",
                    "dest": "contrib/minizip",
                    "dest-filename": "autogen.sh",
                    "commands": [
                        "autoreconf -vfi"
                    ]
                }
            ]
        },
        {
            "name": "libspeechd",
            "config-opts": [
                "--disable-python",
                "--with-systemdsystemunitdir=''",
                "--disable-rpath",
                "--disable-static",
                "--with-kali=no",
                "--with-baratinoo=no",
                "--with-ibmtts=no",
                "--with-voxin=no",
                "--without-oss"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/brailcom/speechd/releases/download/0.12.1/speech-dispatcher-0.12.1.tar.gz",
                    "sha256": "b14a5238d287d2dcce4dd42bbd66ca65fa228e7e683708267f7b34036f7ba4b4",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 328138,
                        "url-template": "https://github.com/brailcom/speechd/releases/download/$version/speech-dispatcher-$version.tar.gz"
                    }
                }
            ],
            "cleanup": [
                "/bin",
                "/etc",
                "/libexec",
                "/lib/speech-dispatcher",
                "/share/sounds/speech-dispatcher",
                "/share/speech-dispatcher"
            ],
            "modules": [
                {
                    "name": "dotconf",
                    "cleanup": [
                        "*"
                    ],
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://github.com/williamh/dotconf/archive/refs/tags/v1.4.1.tar.gz",
                            "sha256": "5922c46cacf99b2ecc4853d28a2bda4a489292e73276e604bd9cba29dfca892d",
                            "x-checker-data": {
                                "type": "anitya",
                                "project-id": 13410,
                                "url-template": "https://github.com/williamh/dotconf/archive/refs/tags/v$version.tar.gz"
                            }
                        },
                        {
                            "type": "script",
                            "commands": [
                                "autoreconf -fiv"
                            ],
                            "dest-filename": "autogen.sh"
                        }
                    ]
                }
            ]
        },
        {
            "name": "xiphos",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/crosswire/xiphos/releases/download/4.5.0/xiphos-4.5.0.tar.xz",
                    "sha256": "bad517f01740cbdb37461a8034bcb7218c8a2e634240985574a953f46b56a490",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 372425,
                        "url-template": "https://github.com/crosswire/xiphos/releases/download/$version/xiphos-$version.tar.xz"
                    }
                }
            ]
        }
    ]
}
